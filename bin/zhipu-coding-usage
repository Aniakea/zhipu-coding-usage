#!/usr/bin/env python3
# omarchy:summary=Collect Zhipu Coding Plan usage into one JSON record
# omarchy:args=[--print] [--quiet] [--no-notify] [--set-key [KEY]] [--import-key] [--region cn|intl]
# omarchy:hidden=true
"""Collect Zhipu Coding Plan usage into a single display-ready JSON record.

Fetches the 5-hour and weekly quota windows and last-24h per-model/tool
usage from the Zhipu monitor API
(``open.bigmodel.cn`` by default, ``api.z.ai`` configurable). The record is
written atomically to ``$XDG_STATE_HOME/omarchy/zhipu/usage.json``, where the
bar widget watches it. The API key is used for the requests only — never
written to the state record, the notify state, or any log.

Key setup (run once, then the runtime never touches anything but env/config):

  --set-key [KEY]   write KEY (or a silently prompted value) to the config
  --import-key      copy the key from OpenCode's credential store to the
                    config — an explicit one-time migration, after which the
                    plugin has no runtime dependency on OpenCode
"""

from __future__ import annotations

import argparse
import datetime as dt
import getpass
import json
import os
import sys
from dataclasses import replace
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
import zhipu_collector as zc  # noqa: E402
import zhipu_fetch as zf  # noqa: E402
import zhipu_history as zh  # noqa: E402
import zhipu_insights as zi  # noqa: E402
import zhipu_notify as zn  # noqa: E402
import zhipu_secure as zs  # noqa: E402

def state_paths() -> tuple[Path, Path, Path]:
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    directory = Path(base) / "omarchy" / "zhipu"
    return directory / "usage.json", directory / "notify-state.json", Path(
        os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    ) / "omarchy" / "zhipu-coding-usage.json"


def load_previous(usage_path: Path) -> dict[str, Any] | None:
    data = zs.read_json_bounded(usage_path)
    return data if data else None


def collect_record(config: dict[str, Any], env: dict[str, str]) -> dict[str, Any]:
    usage_path, _, _ = state_paths()
    credentials = zf.resolve_credentials(config, env)
    if credentials is None:
        return zc.stale_record(load_previous(usage_path), "no-key", str(config.get("region") or ""))

    base = zf.REGION_BASE_URLS[credentials.region]
    try:
        quota_payload = zf.fetch_json(base, zf.QUOTA_PATH, credentials, config)
        level, five_hour, weekly = zc.parse_quota(quota_payload)
    except zf.FetchError as exc:
        return zc.stale_record(load_previous(usage_path), exc.code, credentials.region)

    usage = zc.blank_usage()
    try:
        models_payload = zf.fetch_json(base, zf.MODEL_USAGE_PATH, credentials, config, zf.usage_window_params())
        tools_payload = zf.fetch_json(base, zf.TOOL_USAGE_PATH, credentials, config, zf.usage_window_params())
        usage = zc.parse_model_usage(models_payload)
        usage = replace(usage, tools=zc.parse_tool_usage(tools_payload))
    except zf.FetchError:
        pass  # Secondary endpoints: the quota windows stay authoritative.

    now_ms = int(dt.datetime.now().timestamp() * 1000)
    peak = zi.peak_info(dt.datetime.now(), usage.hourLabels, usage.tokensByHour)
    projection = zi.weekly_projection(
        now_ms,
        float(weekly.used or 0.0),
        float(weekly.budget or 0.0),
        int(weekly.resetsAtMs or 0),
    ) if weekly.present and weekly.used and weekly.budget and weekly.resetsAtMs else None
    history = zh.collect_history(usage_path.parent / "history.db", usage)

    record = zc.build_record(credentials.region, level, five_hour, weekly, usage, zc.utcnow_iso(), peak, projection, history)
    return record.to_dict()


# ----------------------------------------------------------------- key setup


def mask_key(key: str) -> str:
    return key[:4] + "…" + key[-4:] if len(key) > 12 else "…"


def save_config_key(config_path: Path, key: str, region: str) -> None:
    config = zf.read_config(config_path)
    config["apiKey"] = key
    config["region"] = region
    zs.write_json_atomic(config_path, config)


def run_key_setup(args: argparse.Namespace, config_path: Path) -> int:
    if args.import_key:
        credentials = zf.find_opencode_credentials()
        if credentials is None:
            sys.stderr.write("no Zhipu key found in OpenCode's auth.json\n")
            return 2
        key, region, source = credentials.key, credentials.region, credentials.source
    else:
        key = args.set_key if args.set_key else getpass.getpass("Zhipu API key: ")
        if not key.strip():
            sys.stderr.write("empty key, nothing written\n")
            return 2
        key = key.strip()
        region = args.region or str(zf.read_config(config_path).get("region") or "").strip().lower() or "cn"

    if args.region:
        region = args.region
    save_config_key(config_path, key, region)
    origin = f" (imported from {source})" if args.import_key else ""
    sys.stdout.write(f"apiKey {mask_key(key)} saved to {config_path}, region {region}{origin}\n")
    return 0


# ---------------------------------------------------------------------- main


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Collect Zhipu Coding Plan usage.")
    parser.add_argument("--print", dest="to_stdout", action="store_true", help="print the record to stdout")
    parser.add_argument("--quiet", action="store_true", help="suppress the stdout summary")
    parser.add_argument("--no-notify", action="store_true", help="never send a desktop notification")
    parser.add_argument("--set-key", dest="set_key", nargs="?", const="",
                        help="save KEY (or prompt for it) to the config file and exit")
    parser.add_argument("--import-key", action="store_true",
                        help="copy the key from OpenCode's credential store to the config file and exit")
    parser.add_argument("--region", choices=("cn", "intl"), help="pin the region written by --set-key/--import-key")
    args = parser.parse_args(argv)

    usage_path, notify_path, config_path = state_paths()

    if args.set_key is not None or args.import_key:
        return run_key_setup(args, config_path)

    config = zf.read_config(config_path)
    record = collect_record(config, dict(os.environ))

    zs.write_json_atomic(usage_path, record)
    zn.maybe_notify(
        record,
        enabled=not args.no_notify and config.get("notify", True) is not False,
        lang=zn.notify_lang(config),
        notify_state_path=notify_path,
    )

    if args.to_stdout:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")
    elif not args.quiet:
        if record.get("error"):
            sys.stderr.write(f"zhipu usage: {record['error']}\n")
        else:
            five = record["fiveHour"].get("percent")
            weekly = record["weekly"].get("percent")
            five_text = f"{five:.0f}%" if isinstance(five, (int, float)) else "—"
            weekly_text = f"{weekly:.0f}%" if isinstance(weekly, (int, float)) else "—"
            sys.stdout.write(f"{record.get('planLabel') or 'Coding Plan'}: 5h {five_text} · weekly {weekly_text}\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
